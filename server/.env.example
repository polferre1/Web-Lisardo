# Copia este archivo a ".env" y rellena los valores.

# Token secreto para entrar al panel /admin y llamar a las rutas de escritura.
# Genera uno fuerte, por ejemplo con: openssl rand -hex 24
ADMIN_TOKEN=

# Puerto donde escucha el servidor.
PORT=4000

# Origen permitido para peticiones CORS desde la web pública (opcional).
# Ejemplo: https://www.cafelisardo.com
ALLOWED_ORIGIN=*
